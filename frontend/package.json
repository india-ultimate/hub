{
  "scripts": {
    "dev": "yarn webpack serve --mode development --config-node-env development",
    "build-dev": "yarn webpack --mode development --config-node-env development",
    "build": "yarn webpack --mode production --config-node-env production"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@github/webauthn-json": "^2.1.1",
    "@modular-forms/solid": "^0.25.1",
    "@solidjs/router": "^0.8.4",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "babel-preset-solid": "^1.9.16",
    "clsx": "^2.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "dompurify": "^3.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.12.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrious": "^4.0.2",
    "raw-loader": "^4.0.2",
    "remark-gfm": "^4.0.1",
    "slug": "^12.0.1",
    "solid-heroicons": "^3.2.4",
    "solid-hot-loader": "^0.0.5",
    "solid-js": "^1.9.17",
    "solid-markdown": "^2.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "dependencies": {
    "@tanstack/solid-query": "^4.44.0",
    "@tanstack/solid-table": "^8.21.3",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "@thisbeyond/solid-select": "^0.16.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "modern-screenshot": "^4.7.0"
  },
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "arrowParens": "avoid",
    "plugins": [
      "./node_modules/prettier-plugin-tailwindcss/dist/index.mjs"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "plugins": [
      "solid",
      "unused-imports",
      "simple-import-sort"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:solid/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "quotes": [
        "error",
        "double"
      ],
      "comma-dangle": [
        "error",
        "never"
      ],
      "arrow-parens": [
        "error",
        "as-needed"
      ],
      "no-irregular-whitespace": [
        "error",
        {
          "skipJSXText": true
        }
      ],
      "unused-imports/no-unused-imports": "error",
      "no-unused-vars": [
        "error",
        {
          "vars": "all",
          "args": "after-used",
          "ignoreRestSiblings": false,
          "varsIgnorePattern": "^_"
        }
      ],
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    },
    "ignorePatterns": [
      "dist/*",
      "*.config.js"
    ]
  },
  "license": "AGPL-3.0-only"
}
